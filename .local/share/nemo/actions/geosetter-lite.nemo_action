[Nemo Action]
Active=true
Name=Geosetter
Comment=Starte Geosetter
Exec=bash -c 'source ~/programmieren/geosetter-lite/.venv/bin/activate && python3 ~/programmieren/geosetter-lite/main.py %F'
Icon-Name=org.openstreetmap.josm
# Show only for a [s]ingle selection
Selection=s
# Show only for [dir]ectories
Extensions=dir;
Quote=Double
Locations=~/Bilder*;
